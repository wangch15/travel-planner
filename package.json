{
  "name": "travel-planner",
  "version": "1.1.3",
  "private": true,
  "description": "公開的旅程網頁模板：引擎 + trips/<slug>/ 內容",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.js",
    "check": "node scripts/check.js",
    "build": "node scripts/build.js",
    "preview": "node scripts/preview.js",
    "ship": "node scripts/ship.js",
    "adopt-deploy": "node scripts/adopt-deploy.js",
    "unship": "node scripts/unship.js",
    "new": "node scripts/new-trip.js",
    "trips": "node scripts/list-trips.js",
    "update-check": "node scripts/update-check.js",
    "contrib-check": "node scripts/contrib-check.js",
    "migrate": "node scripts/migrate.js",
    "desktop:prototype": "npm run start --workspaces --workspace=@travel-planner/desktop",
    "basemap": "node tools/basemap/index.mjs",
    "photos": "node scripts/photos.js",
    "test": "node --test \"tests/**/*.test.js\" \"tests/**/*.test.mjs\"",
    "sync:agent-assets": "node scripts/sync-agent-assets.mjs",
    "desktop:setup": "npm install --workspaces --include-workspace-root"
  },
  "dependencies": {
    "pngjs": "^7.0.0",
    "acorn": "8.18.0"
  },
  "devDependencies": {
    "wrangler": "4.135.0"
  },
  "workspaces": [
    "packages/*",
    "desktop/prototype"
  ]
}
